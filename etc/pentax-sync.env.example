# Copy to /etc/pentax-sync.env and set mode 600.
CAMERA_SSID=
CAMERA_WIFI_PASSWORD=
CAMERA_BASE_URL=http://192.168.0.1
WIFI_INTERFACE=wlan0
UDHCPC_SCRIPT_PATH=/opt/pentax-sync/udhcpc-script

# Set this to the directory exported by Samba and indexed by Jellyfin.
PHOTO_ROOT=/srv/pentax-sync/photos
STATE_DIR=/var/lib/pentax-sync
STATUS_FILE=/run/pentax-sync/status.json
JPEG_SUBDIR=_jpeg

# Create an API key in Jellyfin and place it here to trigger debounced refreshes.
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
JELLYFIN_REFRESH_DEBOUNCE=10
JELLYFIN_REFRESH_INTERVAL=300

# Network timeouts in seconds.
CAMERA_REQUEST_TIMEOUT=5
CAMERA_DOWNLOAD_TIMEOUT=180

POLL_INTERVAL=2
FULL_SCAN_INTERVAL=60
INITIAL_SYNC=baseline
# Optional inclusive capture-date filter; accepts YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS.
PHOTO_DATE_FROM=
# JPEG preview size and compression (4K long side, stronger compression).
RAW_PREVIEW_MAX_SIDE=3840
RAW_PREVIEW_QUALITY=70
CONNECT_RETRY_INTERVAL=12
CAMERA_STATIC_ADDRESS=192.168.0.2/24
LOG_LEVEL=INFO
